# Retell dashboard: https://beta.retellai.com  (or https://dashboard.retellai.com)
RETELL_API_KEY=
RETELL_AGENT_ID=

# Leave empty to auto-generate a token on startup (check the UI "Auth header" field).
PRESENTER_TOOL_TOKEN=
DIRECTOR_WEBHOOK_TOKEN=

# Public HTTPS origin Retell can reach. Leave EMPTY unless you have a stable
# custom domain. Do not paste trycloudflare/ngrok URLs here — they die on restart
# and then Retell Add Tools hangs with nothing in the local console.
# Example: https://ppt.example.com
PUBLIC_BASE_URL=
DIRECTOR_PUBLIC_URL=

APP_HOST=127.0.0.1
APP_PORT=8787
AUTO_TUNNEL=true
DIRECTOR_AUTO_TUNNEL=true
VERIFY_RETELL_SIGNATURE=true
# Tile the windowed slideshow on the left and AIRA on the right of the primary monitor.
PRESENTER_SPLIT_LAYOUT=true
PRESENTER_SLIDE_RATIO=0.67

# Grounded Q&A. With Azure values empty or unavailable, the app safely abstains
# instead of selecting a local keyword answer. Deployment names are the names
# configured in Azure OpenAI, not necessarily the underlying model names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=presenter_knowledge
QA_KNOWLEDGE_DIR=data/knowledge_sources
QA_AUTO_INDEX=true
# When true, every grounded answer selects the best valid supporting slide.
# An explicit "Recommended visual support: slide N" in a source takes priority.
QA_ALWAYS_SELECT_SLIDE=true
QA_TOP_K_KNOWLEDGE=6
QA_TOP_K_SLIDES=3
QA_MIN_ANSWER_CONFIDENCE=0.35
QA_MIN_SLIDE_CONFIDENCE=0.45
QA_AZURE_TIMEOUT_S=12
QA_MAX_COMPLETION_TOKENS=1200

# Silence after each spoken line before the next slide (milliseconds).
# 800 is tight; 1500–2500 feels more like a presenter pause.
SLIDE_PAUSE_MS=800
# Optional override. If empty, the reminder uses SLIDE_PAUSE_MS.
# RETELL_REMINDER_TRIGGER_MS=
# RETELL_REMINDER_MAX_COUNT=50
